        "tiling_entity_map": {
        "scope": "rust",
        "prefix": "entitymap",
        "body": [
            "",
            "        RonAssetPlugin::<${1:Something}Seri>::new(&[\"${5:something}.ron\"]),",
            "        .load_collection::<${1:Something}SerisHandles>()",

            "#[derive(Resource, Debug, Default Reflect)]",
            "#[reflect(Resource, Default)]//SE PUEDE IMPLEMENTAR UN ReflectDefault",
            "pub struct ${1:Something}EntityMap(pub HashIdToEntityMap);",
            "           .register_type::<${1:Something}EntityMap>()",
            "",
            "#[derive(AssetCollection, Resource)]",
            "pub struct ${1:Something}SerisHandles {",
            "    #[asset(path =\"ron/${5:somepathhhhhhhhhhh}\", , collection(typed))]",
            "    pub handles: Vec<Handle<${1:Something}Seri>>,", 
            "}",
            "#[derive(serde::Deserialize, Asset, Reflect, Default)]",
            "pub struct ${1:Something}Seri {",
            "    pub id: String,",
            "}",
            "/// MOVER A _systems.rs",
            "#[allow(unused_parens)]",
            "pub fn init_${5:something}s -> Result (",
            "    mut cmd: Commands, map: Option<Res<${1:Something}EntityMap>>,",
            "    mut seris_handles: ResMut<${1:Something}SerisHandles>,",
            "    mut assets: ResMut<Assets<${1:Something}Seri>>,",
            ") {",
            "    if map.is_some(){ return Ok(());}",
            "    cmd.init_resource::<${1:Something}EntityMap>();",
            "    for handle in std::mem::take(&mut seris_handles.handles) {",
            "        let Some(seri) = assets.get(&handle) else {",
            "            warn!(target: \"${5:something}_loading\", \"Failed to load ${1:Something}Seri from handle: {:?}\", handle);",
            "            continue;",
            "        };",

            "        info!(target: \"${5:something}_loading\", \"Loading ${1:Something}Seri from handle: {:?}\", handle);",
            "    }",
            "    Ok(())",
            "}",

            "pub fn add_${5:something}s_to_map(",
            "    map: Option<ResMut<${1:Something}EntityMap>>,",
            "    query: Query<(Entity, &EntityPrefix, &StrId), (Added<${1:Something}>, )>,",
            ") -> Result<(), String> {",
            "    let mut result: Result<(), String> = Ok(());",
            "    if let Some(mut map) = map {",
            "        for (ent, prefix, str_id) in query.iter() {",
            "            if let Err(err) = map.0.insert(str_id, ent) {",
            "                error!(target: \"${5:something}_loading\", \"{} {} already in ${1:Something}EntityMap : {}\", prefix, str_id, err);",
            "                result = Err(err);",
            "            } else {",
            "                info!(target: \"${5:something}_loading\", \"Inserted '{}' into ${1:Something}EntityMap with entity {:?}\", str_id, ent);",
            "            }",
            "        }",
            "    }",
            "    result",
            "}",
            "",
            "        .add_systems(OnEnter(AssetsLoadingState::ReplicatedFinished), (",
            "            (init_dimensions, add_${5:something}_to_map).chain(),",
            "        ))",
            "        .add_systems(Update, (",
            "            add_${5:something}s_to_map.run_if(not(server_or_singleplayer)),",
            "        ))",
            "      ",  ],
        },

