    "on_receive_server_event": {
        "scope": "rust",
        "prefix": "recserv",
        "body": [
            "pub fn on_receive_${1:EventType}_from_server(",
            "    trigger: Trigger<${1:EventType}>,",
            "    mut query: Query<&mut ${2:ComponentType}, >,",
            "    server: Option<Res<RenetServer>>,",
            "    mut map: ResMut<ServerEntityMap>,",
            ") {",
            "    if server.is_some() { return; }",
            "",
            "    let ${1:EventType} { entity, data } = trigger.event().clone();",
            "",
            "    if let Some(entity) = map.server_entry(entity).get() {",
            "        if let Ok(mut comp) = query.get_mut(entity) {",
            "            *comp = data;",
            "            //info!(\"Received state for entity {:?}: {:?}\", entity, comp);",
            "        } else {",
            "            warn!(\"Received state for entity {:?} that does not exist or is not valid.\", entity);",
            "        }",
            "    }",
            "    else {",
            "        warn!(\"Received state for entity {:?} that is not in the server entity map.\", entity);",
            "    }",
            "}"
        ],
        "description": "Generic snippet for receiving and applying server events to components"
    },
